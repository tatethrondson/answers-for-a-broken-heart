{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/author-tate.jpg",
      "destination": "https://avatars.githubusercontent.com/u/314793130?v=4"
    },
    {
      "source": "/start-here",
      "destination": "/begin-here.html"
    },
    {
      "source": "/what-hurts-today",
      "destination": "/start-here.html"
    },
    {
      "source": "/all-answers",
      "destination": "/what-hurts-today.html"
    }
  ],
  "headers": [
    {
      "source": "/author-tate.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/author-photo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
